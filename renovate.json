{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate configuration for a React Native Yarn monorepo using Lerna. All updates are disabled.",
  "extends": [
    "config:recommended"
  ],

  // Keep Renovate active but silent (no PRs or updates)
  "enabled": true,

  // Detect Yarn workspaces and Lerna packages
  "npmClient": "yarn",
  "monorepo": {
    "enabled": true
  },
  "lerna": {
    "enabled": true
  },
  "rangeStrategy": "replace",

  // Do not modify or update dependencies
  "ignoreDeps": ["*"],

  // Disable all update behaviors for all managers
  "packageRules": [
    {
      "matchManagers": ["npm", "yarn", "lerna", "github-actions", "dockerfile"],
      "matchPackagePatterns": [".*"],
      "enabled": false
    }
  ],

  // Prevent PRs, branches, or commits
  "branchConcurrentLimit": 0,
  "prCreation": "none",
  "rebaseWhen": "never",
  "commitMessagePrefix": "[skip renovate]",

  // Disable all automerge and lockfile maintenance
  "automerge": false,
  "lockFileMaintenance": {
    "enabled": false
  },

  // Don't update monorepo package versions (like babel monorepo, expo monorepo)
  "ignorePresets": ["group:monorepos"],

  // Keep logs clean
  "logLevel": "warn",

  // Optional: exclude internal packages from analysis (optional safety)
  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**"
  ]
}
