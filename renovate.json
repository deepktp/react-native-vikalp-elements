{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate configuration for a React Native Yarn monorepo using Lerna. All updates are disabled.",
  "extends": [
    "config:recommended"
  ],

  "enabled": true,

  "npmClient": "yarn",
  "monorepo": {
    "enabled": true
  },
  "lerna": {
    "enabled": true
  },
  "rangeStrategy": "replace",

  "ignoreDeps": ["*"],

  "packageRules": [
    {
      "matchManagers": ["npm", "yarn", "lerna", "github-actions", "dockerfile"],
      "matchPackagePatterns": [".*"],
      "enabled": false
    }
  ],

  "branchConcurrentLimit": 0,
  "prCreation": "none",
  "rebaseWhen": "never",
  "commitMessagePrefix": "[skip renovate]",

  "automerge": false,
  "lockFileMaintenance": {
    "enabled": false
  },

  "ignorePresets": ["group:monorepos"],

  "logLevel": "warn",

  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**"
  ]
}
