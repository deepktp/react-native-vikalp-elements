{
  "extends": "../../tsconfig",
  "compilerOptions": {
    "allowJs": true,
    "outDir": "dist",
    "declaration": false,
    "composite": false,
    "rootDir": "src",
    "jsx": "react",            
    "esModuleInterop": true, 
  },
  "include": ["src/**/*.tsx", "src/**/*.ts", "src/index.ts"],
  "exclude": [
    ".ci",
    "dist",
    "node_modules",
    "babel.config.ts",
    "jest.config.ts",
    "src/index.d.ts",
    "src/**/__tests__",
    "src/**/*.usage.tsx"
  ]
}
