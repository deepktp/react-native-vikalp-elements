{
  "extends": "../../tsconfig",
  "references": [
    {
      "path": "../base"
    }
  ],
  "compilerOptions": {
    "allowJs": true,
    "outDir": "dist",
    "declaration": true,
    "composite": true,
    "rootDir": "src",
    "skipLibCheck": true,
    "jsx": "react",
    "esModuleInterop": true
  },
  "include": ["src/**/*.tsx", "src/**/*.ts", "src/index.ts"],
  "exclude": [
    ".ci",
    "dist",
    "node_modules",
    "babel.config.ts",
    "jest.config.ts",
    "src/index.d.ts",
    "src/**/__tests__",
    "src/**/*.usage.tsx"
  ]
}
